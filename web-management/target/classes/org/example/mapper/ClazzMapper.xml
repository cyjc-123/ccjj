<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.mapper.ClazzMapper">

    <select id="PageSelect" resultType="org.example.pojo.Clazz">
        select c.* ,e.name  masterName from clazz c left join emp e on e.id=c.master_id
        <where>
            <if test="name!=null and name!=''">
                c.name=#{name}
            </if>
            <if test="begin!=null and end!=null">
                and c.end_date between #{begin} and #{end}
            </if>

        </where>
        order by update_time
    </select>
</mapper>